{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"cwtools.trace.server": "messages",
		"cwtools.localisation.languages": ["English"],
		"cwtools.errors.vanilla": false,
		"cwtools.ignore_patterns": [
			"**/.transfer your modding stuff here/**",
			"**/*.bak"
		],

		"files.associations": {
			"*.txt": "ck2",
			"*.gui": "ck2",
			"*.gfx": "ck2",
			"*.sfx": "ck2",
			"*.asset": "ck2",
			"*.mod": "ck2",
			"credits.txt": "plaintext",
			"ValidatorSettings.txt": "plaintext"
		},

		"files.encoding": "windows1252",
		"files.autoGuessEncoding": false,
		"files.eol": "\r\n",
		"files.trimTrailingWhitespace": false,
		"files.insertFinalNewline": false,
		"editor.formatOnSave": false,
		"editor.bracketPairColorization.enabled": true,
		"[ck2]": {
			"editor.insertSpaces": false,
			"editor.tabSize": 4,
			"editor.detectIndentation": true
		},
		"[json]": { "files.encoding": "utf8" },
		"[jsonc]": { "files.encoding": "utf8" },
		"[markdown]": { "files.encoding": "utf8" },

		"search.exclude": {
			"**/.transfer your modding stuff here/**": true
		},
		"files.watcherExclude": {
			"**/.transfer your modding stuff here/**": true
		}
	}
}
